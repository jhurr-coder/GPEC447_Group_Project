from arcgis.gis import GIS
from arcgis.features import FeatureLayer
import geopandas as gpd
from shapely.geometry import Point
import matplotlib.pyplot as plt
import matplotlib.patches as mpatches
import pandas as pd
import requests

# ── 1. Connect ────────────────────────────────────────────────────────────────
gis = GIS(username='gpec447sp26_11')

# ── 2. Find group and list items ──────────────────────────────────────────────
group = gis.groups.search("gpec 447_hurr_li_phouasalith")[0]
print(f"Group found: {group.title}")
for item in group.content():
    print(f"  [{item.type}] {item.title} — id: {item.id}")

# ── 3. Load feature layers ────────────────────────────────────────────────────
broad_item = gis.content.search("industrial_businesses_broad_geocoded",
                                 item_type="Feature Layer")[0]
core_item  = gis.content.search("industrial_businesses_core_geocoded",
                                 item_type="Feature Layer")[0]
print(f"\nBroad: {broad_item.title}")
print(f"Core:  {core_item.title}")

# ── 4. Query to SDF ───────────────────────────────────────────────────────────
broad_sdf = broad_item.layers[0].query(as_df=True)
core_sdf  = core_item.layers[0].query(as_df=True)

# ── 5. Convert SDF to GeoDataFrame ───────────────────────────────────────────
def sdf_to_gdf(sdf):
    sdf = sdf.copy()
    if "SHAPE" in sdf.columns:
        sdf["lon"] = sdf["SHAPE"].apply(lambda g: g["x"] if isinstance(g, dict) else None)
        sdf["lat"] = sdf["SHAPE"].apply(lambda g: g["y"] if isinstance(g, dict) else None)
        sdf = sdf.dropna(subset=["lon", "lat"])
        return gpd.GeoDataFrame(sdf,
            geometry=gpd.points_from_xy(sdf["lon"], sdf["lat"]),
            crs="EPSG:4326")
    else:
        return gpd.GeoDataFrame(sdf,
            geometry=gpd.points_from_xy(sdf["longitude"], sdf["latitude"]),
            crs="EPSG:4326")

broad_gdf = sdf_to_gdf(broad_sdf)
core_gdf  = sdf_to_gdf(core_sdf)

# ── 6. Fix mislabeled CRS ────────────────────────────────────────────────────
broad_gdf = broad_gdf.set_crs("EPSG:3857", allow_override=True).to_crs("EPSG:4326")
core_gdf  = core_gdf.set_crs("EPSG:3857", allow_override=True).to_crs("EPSG:4326")

print(f"\nBroad GDF: {len(broad_gdf):,} points | x: {round(broad_gdf.geometry.x.min(),2)} to {round(broad_gdf.geometry.x.max(),2)}")
print(f"Core GDF:  {len(core_gdf):,} points  | x: {round(core_gdf.geometry.x.min(),2)} to {round(core_gdf.geometry.x.max(),2)}")

# ── 7. Load San Diego County boundary from Census TIGER ──────────────────────
print("\nLoading San Diego County boundary...")
sd_county_url = (
    "https://raw.githubusercontent.com/plotly/datasets/master/"
    "geojson-counties-fips.json"
)
# Use Census TIGER via geopandas read — San Diego FIPS = 06073
tiger_url = (
    "https://www2.census.gov/geo/tiger/TIGER2022/COUNTY/"
    "tl_2022_us_county.zip"
)

try:
    counties = gpd.read_file(tiger_url)
    sd_county = counties[counties["GEOID"] == "06073"].to_crs("EPSG:4326")
    print(f"San Diego County boundary loaded: {len(sd_county)} polygon(s)")
except Exception as e:
    print(f"TIGER download failed: {e}")
    print("Using manual bounding box as fallback...")
    from shapely.geometry import box
    sd_county = gpd.GeoDataFrame(
        geometry=[box(-117.60, 32.50, -116.08, 33.51)],
        crs="EPSG:4326"
    )

# ── 8. Clip points to San Diego County boundary ───────────────────────────────
broad_gdf = gpd.clip(broad_gdf, sd_county)
core_gdf  = gpd.clip(core_gdf,  sd_county)

print(f"After clipping to SD County:")
print(f"  Broad: {len(broad_gdf):,} points")
print(f"  Core:  {len(core_gdf):,} points")

# ── 9. Plot side-by-side map ──────────────────────────────────────────────────
area_coords = {
    "Otay Mesa":       (-117.0548, 32.5751),
    "Kearny Mesa":     (-117.1397, 32.8264),
    "Miramar":         (-117.1050, 32.8970),
    "Sorrento Valley": (-117.2025, 32.8948),
}

colors = {
    "Manufacturing":                  "#2c7bb6",
    "Wholesale Trade":                "#fdae61",
    "Transportation and Warehousing": "#d7191c",
}

fig, axes = plt.subplots(1, 2, figsize=(20, 10))

for ax, gdf, title in [
    (axes[0], broad_gdf, f"Broad Dataset (n={len(broad_gdf):,})"),
    (axes[1], core_gdf,  f"Core Dataset (n={len(core_gdf):,})"),
]:
    ax.set_aspect("auto")

    # Draw San Diego County boundary
    sd_county.boundary.plot(ax=ax, color="gray", linewidth=1.0, linestyle="-")

    # Plot points by industry group
    if "industry_group" in gdf.columns:
        for group_name, color in colors.items():
            subset = gdf[gdf["industry_group"] == group_name]
            if len(subset):
                ax.scatter(subset.geometry.x, subset.geometry.y,
                           c=color, s=5, alpha=0.7,
                           label=f"{group_name} (n={len(subset):,})")
    else:
        ax.scatter(gdf.geometry.x, gdf.geometry.y,
                   c="#2c7bb6", s=5, alpha=0.7,
                   label=f"All businesses (n={len(gdf):,})")

    # Draw 1-mile study area buffers
    for name, (x, y) in area_coords.items():
        center = gpd.GeoDataFrame(
            geometry=[Point(x, y)], crs="EPSG:4326"
        ).to_crs("EPSG:26911")
        buffer = center.geometry.buffer(1609).to_crs("EPSG:4326")
        bx, by = buffer.iloc[0].exterior.xy
        ax.plot(bx, by, color="black", linewidth=1.5, linestyle="--")
        ax.annotate(name, xy=(x, y), fontsize=8,
                    fontweight="bold", ha="center", color="black",
                    bbox=dict(boxstyle="round,pad=0.2", fc="white", alpha=0.6))

    # Set extent to SD County bounds with small padding
    minx, miny, maxx, maxy = sd_county.total_bounds
    ax.set_xlim(minx - 0.05, maxx + 0.05)
    ax.set_ylim(miny - 0.05, maxy + 0.05)

    ax.set_title(title, fontsize=12, fontweight="bold")
    ax.legend(fontsize=7, loc="upper left")
    ax.set_xlabel("Longitude")
    ax.set_ylabel("Latitude")
    ax.grid(alpha=0.2)

plt.suptitle("San Diego County Industrial Businesses — Broad vs Core Classification",
             fontsize=13, fontweight="bold")
plt.tight_layout()
plt.savefig("broad_vs_core_sd_county_map.png", dpi=150, bbox_inches="tight")
plt.show()
print("Saved: broad_vs_core_sd_county_map.png")

# ── 10. Business count summary per study area ─────────────────────────────────
print("\n" + "=" * 65)
print("BUSINESS COUNTS BY STUDY AREA (1-mile radius, validated data)")
print("=" * 65)

gdf_proj = core_gdf.to_crs("EPSG:26911")
rows = []

for area_name, (x, y) in area_coords.items():
    center = gpd.GeoDataFrame(
        geometry=[Point(x, y)], crs="EPSG:4326"
    ).to_crs("EPSG:26911")
    buffer_geom = center.geometry.buffer(1609).iloc[0]
    subset = gdf_proj[gdf_proj.geometry.within(buffer_geom)]
    counts = subset["industry_group"].value_counts() if "industry_group" in subset.columns else {}
    rows.append({
        "area":             area_name,
        "total_businesses": len(subset),
        "manufacturing":    counts.get("Manufacturing", 0),
        "wholesale":        counts.get("Wholesale Trade", 0),
        "transport_wh":     counts.get("Transportation and Warehousing", 0),
    })

summary = pd.DataFrame(rows)
summary["freight_pct"] = (
    summary["transport_wh"] / summary["total_businesses"].replace(0, 1) * 100
).round(1)

print(summary.to_string(index=False))
summary.to_csv("study_area_summary_core.csv", index=False)
print("\nSaved: study_area_summary_core.csv")
