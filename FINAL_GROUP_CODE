from arcgis.gis import GIS
from arcgis.features import FeatureLayer
import geopandas as gpd
from shapely.geometry import Point
import matplotlib.pyplot as plt
import matplotlib.patches as mpatches
import contextily as ctx
import pandas as pd

# ── 1. Connect ────────────────────────────────────────────────────────────────
gis = GIS(username='gpec447sp26_11')

# ── 2. Find group ─────────────────────────────────────────────────────────────
group = gis.groups.search("gpec 447_hurr_li_phouasalith")[0]
print(f"Group found: {group.title}")

# ── 3. Load core feature layer ────────────────────────────────────────────────
core_item = gis.content.search("industrial_businesses_core_geocoded",
                                item_type="Feature Layer")[0]
print(f"Core: {core_item.title}")
core_sdf = core_item.layers[0].query(as_df=True)

# ── 4. Convert to GeoDataFrame ───────────────────────────────────────────────
def sdf_to_gdf(sdf):
    sdf = sdf.copy()
    if "SHAPE" in sdf.columns:
        sdf["lon"] = sdf["SHAPE"].apply(lambda g: g["x"] if isinstance(g, dict) else None)
        sdf["lat"] = sdf["SHAPE"].apply(lambda g: g["y"] if isinstance(g, dict) else None)
        sdf = sdf.dropna(subset=["lon", "lat"])
        return gpd.GeoDataFrame(sdf,
            geometry=gpd.points_from_xy(sdf["lon"], sdf["lat"]),
            crs="EPSG:4326")
    else:
        return gpd.GeoDataFrame(sdf,
            geometry=gpd.points_from_xy(sdf["longitude"], sdf["latitude"]),
            crs="EPSG:4326")

core_gdf = sdf_to_gdf(core_sdf)

# ── 5. Fix mislabeled CRS then set to EPSG:2230 (NAD83 CA State Plane Zone 6)
# Pipeline: Web Mercator coords → label as 3857 → reproject to 4326 → to 2230
core_gdf = core_gdf.set_crs("EPSG:3857", allow_override=True).to_crs("EPSG:4326")
core_gdf_2230 = core_gdf.to_crs("EPSG:2230")
print(f"Core GDF: {len(core_gdf_2230):,} points | CRS: {core_gdf_2230.crs}")

# ── 6. Load boundary layers in EPSG:2230 ─────────────────────────────────────
print("\nLoading boundary layers...")

tiger_url = (
    "https://www2.census.gov/geo/tiger/TIGER2022/COUNTY/"
    "tl_2022_us_county.zip"
)
try:
    counties  = gpd.read_file(tiger_url)
    sd_county = counties[counties["GEOID"] == "06073"].to_crs("EPSG:2230")
    print(f"SD County boundary loaded")
except Exception as e:
    print(f"TIGER failed: {e} — using bounding box")
    from shapely.geometry import box
    sd_county = gpd.GeoDataFrame(
        geometry=[box(-117.60, 32.50, -116.08, 33.51)], crs="EPSG:4326"
    ).to_crs("EPSG:2230")

cpd_url = "https://seshat.datasd.org/sde/sgid_planning/communities_datasd.zip"
try:
    cpd = gpd.read_file(cpd_url).to_crs("EPSG:2230")
    print(f"Community planning districts loaded: {len(cpd)} districts")
    has_cpd = True
except Exception as e:
    print(f"CPD load failed: {e}")
    has_cpd = False

# Install contextily if needed: pip install contextily
try:
    import contextily as ctx
    has_ctx = True
    print("Contextily available — basemap will be added")
except ImportError:
    has_ctx = False
    print("Contextily not installed — run: pip install contextily")

# ── 7. Clip to SD County ──────────────────────────────────────────────────────
core_gdf_2230 = gpd.clip(core_gdf_2230, sd_county)
print(f"After clipping: {len(core_gdf_2230):,} points")

# ── 8. Study areas — reproject centers and buffers to EPSG:2230 ──────────────
area_coords_wgs = {
    "Otay Mesa":       (-117.0548, 32.5751),
    "Kearny Mesa":     (-117.1397, 32.8264),
    "Miramar":         (-117.1050, 32.8970),
    "Sorrento Valley": (-117.2025, 32.8948),
}

# Build buffers in EPSG:2230 (feet — 1 mile = 5280 feet)
buffers_2230 = {}
centers_2230 = {}
for name, (lon, lat) in area_coords_wgs.items():
    pt = gpd.GeoDataFrame(
        geometry=[Point(lon, lat)], crs="EPSG:4326"
    ).to_crs("EPSG:2230")
    centers_2230[name] = pt.geometry.iloc[0]
    buffers_2230[name] = pt.geometry.buffer(5280).iloc[0]  # 1 mile in feet

colors = {
    "Manufacturing":                  "#2c7bb6",
    "Wholesale Trade":                "#fdae61",
    "Transportation and Warehousing": "#d7191c",
}

# ── 9. MAIN MAP — full SD County ──────────────────────────────────────────────
fig, ax = plt.subplots(figsize=(14, 12))
ax.set_aspect("equal")

# Layer 1: Community planning districts
if has_cpd:
    cpd.plot(ax=ax, color="#f0ede8", edgecolor="#c8c0b8",
             linewidth=0.4, alpha=0.9, zorder=1)

# Layer 2: SD County boundary
sd_county.boundary.plot(ax=ax, color="#333333",
                        linewidth=2.0, zorder=2)

# Layer 3: Basemap (OpenStreetMap tiles)
if has_ctx:
    ctx.add_basemap(ax, crs=core_gdf_2230.crs.to_string(),
                    source=ctx.providers.CartoDB.Positron,
                    zoom=11, alpha=0.6, zorder=0)

# Layer 4: Business points
if "industry_group" in core_gdf_2230.columns:
    for group_name, color in colors.items():
        subset = core_gdf_2230[core_gdf_2230["industry_group"] == group_name]
        if len(subset):
            ax.scatter(subset.geometry.x, subset.geometry.y,
                       c=color, s=10, alpha=0.8, zorder=4,
                       label=f"{group_name} (n={len(subset):,})")
else:
    ax.scatter(core_gdf_2230.geometry.x, core_gdf_2230.geometry.y,
               c="#2c7bb6", s=10, alpha=0.8, zorder=4,
               label=f"Industrial businesses (n={len(core_gdf_2230):,})")

# Layer 5: Study area buffers
for name, buf in buffers_2230.items():
    bx, by = buf.exterior.xy
    ax.fill(bx, by, color="yellow", alpha=0.15, zorder=5)
    ax.plot(bx, by, color="black", linewidth=2.0,
            linestyle="--", zorder=6)
    cx, cy = centers_2230[name].x, centers_2230[name].y
    ax.annotate(name, xy=(cx, cy), fontsize=9,
                fontweight="bold", ha="center", color="black", zorder=7,
                bbox=dict(boxstyle="round,pad=0.25", fc="white",
                          ec="black", alpha=0.85, linewidth=0.8))

# Set extent
minx, miny, maxx, maxy = sd_county.total_bounds
ax.set_xlim(minx - 1000, maxx + 1000)
ax.set_ylim(miny - 1000, maxy + 1000)

ax.set_title("San Diego County — Core Industrial & Logistics Businesses\n"
             "by NAICS Sector with Study Area Buffers (1-mile radius) | CRS: EPSG:2230",
             fontsize=13, fontweight="bold")
ax.legend(fontsize=9, loc="upper right", framealpha=0.95, edgecolor="gray")
ax.set_xlabel("Easting (US Survey Feet)", fontsize=9)
ax.set_ylabel("Northing (US Survey Feet)", fontsize=9)
ax.grid(alpha=0.15, zorder=0)

plt.tight_layout()
plt.savefig("core_sd_county_map_2230.png", dpi=150, bbox_inches="tight")
plt.show()
print("Saved: core_sd_county_map_2230.png")

# ── 10. ZOOMED MAP — study areas only ────────────────────────────────────────
fig2, ax2 = plt.subplots(figsize=(13, 11))
ax2.set_aspect("equal")

if has_cpd:
    cpd.plot(ax=ax2, color="#f0ede8", edgecolor="#c8c0b8",
             linewidth=0.5, alpha=0.9, zorder=1)

if has_ctx:
    ctx.add_basemap(ax2, crs=core_gdf_2230.crs.to_string(),
                    source=ctx.providers.CartoDB.Positron,
                    zoom=13, alpha=0.6, zorder=0)

if "industry_group" in core_gdf_2230.columns:
    for group_name, color in colors.items():
        subset = core_gdf_2230[core_gdf_2230["industry_group"] == group_name]
        if len(subset):
            ax2.scatter(subset.geometry.x, subset.geometry.y,
                        c=color, s=14, alpha=0.85, zorder=4,
                        label=f"{group_name} (n={len(subset):,})")

for name, buf in buffers_2230.items():
    bx, by = buf.exterior.xy
    ax2.fill(bx, by, color="yellow", alpha=0.2, zorder=5)
    ax2.plot(bx, by, color="black", linewidth=2.2,
             linestyle="--", zorder=6)
    cx, cy = centers_2230[name].x, centers_2230[name].y
    ax2.annotate(name, xy=(cx, cy), fontsize=10,
                 fontweight="bold", ha="center", color="black", zorder=7,
                 bbox=dict(boxstyle="round,pad=0.3", fc="white",
                           ec="black", alpha=0.9, linewidth=1.0))

# Zoom extent to study areas
all_buf_xs = [c.x for c in centers_2230.values()]
all_buf_ys = [c.y for c in centers_2230.values()]
pad = 10000  # feet
ax2.set_xlim(min(all_buf_xs) - pad, max(all_buf_xs) + pad)
ax2.set_ylim(min(all_buf_ys) - pad, max(all_buf_ys) + pad)

ax2.set_title("Study Areas — Zoomed View\n"
              "Core Industrial & Logistics Businesses by NAICS Sector | CRS: EPSG:2230",
              fontsize=13, fontweight="bold")
ax2.legend(fontsize=9, loc="upper right", framealpha=0.95, edgecolor="gray")
ax2.set_xlabel("Easting (US Survey Feet)", fontsize=9)
ax2.set_ylabel("Northing (US Survey Feet)", fontsize=9)
ax2.grid(alpha=0.15, zorder=0)

plt.tight_layout()
plt.savefig("core_study_areas_zoom_2230.png", dpi=150, bbox_inches="tight")
plt.show()
print("Saved: core_study_areas_zoom_2230.png")

# ── 11. Business count summary ────────────────────────────────────────────────
print("\n" + "=" * 65)
print("BUSINESS COUNTS BY STUDY AREA (1-mile radius, EPSG:2230)")
print("=" * 65)

rows = []
for area_name, buf_geom in buffers_2230.items():
    subset = core_gdf_2230[core_gdf_2230.geometry.within(buf_geom)]
    counts = (subset["industry_group"].value_counts()
              if "industry_group" in subset.columns else {})
    rows.append({
        "area":             area_name,
        "total_businesses": len(subset),
        "manufacturing":    counts.get("Manufacturing", 0),
        "wholesale":        counts.get("Wholesale Trade", 0),
        "transport_wh":     counts.get("Transportation and Warehousing", 0),
    })

summary = pd.DataFrame(rows)
summary["freight_pct"] = (
    summary["transport_wh"] /
    summary["total_businesses"].replace(0, 1) * 100
).round(1)

print(summary.to_string(index=False))
summary.to_csv("study_area_summary_core_2230.csv", index=False)
print("\nSaved: study_area_summary_core_2230.csv")
