from arcgis.gis import GIS
from arcgis.features import FeatureLayer
import geopandas as gpd
from shapely.geometry import Point
import matplotlib.pyplot as plt
import pandas as pd

# ── 1. Connect ────────────────────────────────────────────────────────────────
gis = GIS(username='gpec447sp26_11')

# ── 2. Find group ─────────────────────────────────────────────────────────────
group = gis.groups.search("gpec 447_hurr_li_phouasalith")[0]
print(f"Group found: {group.title}")
for item in group.content():
    print(f"  [{item.type}] {item.title} — id: {item.id}")

# ── 3. Load core feature layer only ──────────────────────────────────────────
core_item = gis.content.search("industrial_businesses_core_geocoded",
                                item_type="Feature Layer")[0]
print(f"\nCore: {core_item.title} ({core_item.id})")

# ── 4. Query to SDF ───────────────────────────────────────────────────────────
core_sdf = core_item.layers[0].query(as_df=True)
print(f"Columns: {core_sdf.columns.tolist()}")

# ── 5. Convert to GeoDataFrame ───────────────────────────────────────────────
def sdf_to_gdf(sdf):
    sdf = sdf.copy()
    if "SHAPE" in sdf.columns:
        sdf["lon"] = sdf["SHAPE"].apply(lambda g: g["x"] if isinstance(g, dict) else None)
        sdf["lat"] = sdf["SHAPE"].apply(lambda g: g["y"] if isinstance(g, dict) else None)
        sdf = sdf.dropna(subset=["lon", "lat"])
        return gpd.GeoDataFrame(sdf,
            geometry=gpd.points_from_xy(sdf["lon"], sdf["lat"]),
            crs="EPSG:4326")
    else:
        return gpd.GeoDataFrame(sdf,
            geometry=gpd.points_from_xy(sdf["longitude"], sdf["latitude"]),
            crs="EPSG:4326")

core_gdf = sdf_to_gdf(core_sdf)

# ── 6. Fix mislabeled CRS (labeled 4326 but coords are Web Mercator 3857) ────
core_gdf = core_gdf.set_crs("EPSG:3857", allow_override=True).to_crs("EPSG:4326")
print(f"\nCore GDF: {len(core_gdf):,} points")
print(f"x range: {round(core_gdf.geometry.x.min(),2)} to {round(core_gdf.geometry.x.max(),2)}")
print(f"y range: {round(core_gdf.geometry.y.min(),2)} to {round(core_gdf.geometry.y.max(),2)}")

# ── 7. Load boundary layers ───────────────────────────────────────────────────
print("\nLoading boundary layers...")

# San Diego County boundary (Census TIGER)
tiger_url = (
    "https://www2.census.gov/geo/tiger/TIGER2022/COUNTY/"
    "tl_2022_us_county.zip"
)
try:
    counties  = gpd.read_file(tiger_url)
    sd_county = counties[counties["GEOID"] == "06073"].to_crs("EPSG:4326")
    print(f"SD County boundary loaded: {len(sd_county)} polygon(s)")
except Exception as e:
    print(f"TIGER download failed: {e} — using bounding box fallback")
    from shapely.geometry import box
    sd_county = gpd.GeoDataFrame(
        geometry=[box(-117.60, 32.50, -116.08, 33.51)],
        crs="EPSG:4326"
    )

# San Diego community planning districts (city neighborhoods)
cpd_url = (
    "https://seshat.datasd.org/sde/sgid_planning/"
    "communities_datasd.zip"
)
try:
    cpd = gpd.read_file(cpd_url).to_crs("EPSG:4326")
    print(f"Community planning districts loaded: {len(cpd)} districts")
    has_cpd = True
except Exception as e:
    print(f"CPD load failed: {e} — will skip neighborhood layer")
    has_cpd = False

# ── 8. Clip core points to San Diego County ───────────────────────────────────
core_gdf = gpd.clip(core_gdf, sd_county)
print(f"After clipping to SD County: {len(core_gdf):,} points")

# ── 9. Define study areas and colors ─────────────────────────────────────────
area_coords = {
    "Otay Mesa":       (-117.0548, 32.5751),
    "Kearny Mesa":     (-117.1397, 32.8264),
    "Miramar":         (-117.1050, 32.8970),
    "Sorrento Valley": (-117.2025, 32.8948),
}

colors = {
    "Manufacturing":                  "#2c7bb6",
    "Wholesale Trade":                "#fdae61",
    "Transportation and Warehousing": "#d7191c",
}

# ── 10. Main map — core businesses with geography layers ─────────────────────
fig, ax = plt.subplots(figsize=(14, 12))
ax.set_aspect("auto")

# Layer 1: Community planning districts (lightest, bottom)
if has_cpd:
    cpd.plot(ax=ax, color="#f5f5f0", edgecolor="#cccccc",
             linewidth=0.4, alpha=0.8, zorder=1)

# Layer 2: San Diego County boundary
sd_county.boundary.plot(ax=ax, color="#555555",
                        linewidth=1.5, linestyle="-", zorder=2)

# Layer 3: Business points by industry group
if "industry_group" in core_gdf.columns:
    for group_name, color in colors.items():
        subset = core_gdf[core_gdf["industry_group"] == group_name]
        if len(subset):
            ax.scatter(subset.geometry.x, subset.geometry.y,
                       c=color, s=8, alpha=0.75, zorder=3,
                       label=f"{group_name} (n={len(subset):,})")
else:
    ax.scatter(core_gdf.geometry.x, core_gdf.geometry.y,
               c="#2c7bb6", s=8, alpha=0.75, zorder=3,
               label=f"Industrial businesses (n={len(core_gdf):,})")

# Layer 4: Study area 1-mile buffers
for name, (x, y) in area_coords.items():
    center = gpd.GeoDataFrame(
        geometry=[Point(x, y)], crs="EPSG:4326"
    ).to_crs("EPSG:26911")
    buffer = center.geometry.buffer(1609).to_crs("EPSG:4326")
    bx, by = buffer.iloc[0].exterior.xy
    ax.fill(bx, by, color="yellow", alpha=0.15, zorder=4)
    ax.plot(bx, by, color="black", linewidth=1.8,
            linestyle="--", zorder=5)
    ax.annotate(name, xy=(x, y), fontsize=9,
                fontweight="bold", ha="center", color="black", zorder=6,
                bbox=dict(boxstyle="round,pad=0.25", fc="white",
                          ec="black", alpha=0.8, linewidth=0.8))

# Set extent to SD County with padding
minx, miny, maxx, maxy = sd_county.total_bounds
ax.set_xlim(minx - 0.02, maxx + 0.02)
ax.set_ylim(miny - 0.02, maxy + 0.02)

ax.set_title("San Diego County — Core Industrial & Logistics Businesses\n"
             "by NAICS Sector with Study Area Buffers (1-mile radius)",
             fontsize=13, fontweight="bold")
ax.legend(fontsize=9, loc="upper right",
          framealpha=0.9, edgecolor="gray")
ax.set_xlabel("Longitude", fontsize=10)
ax.set_ylabel("Latitude", fontsize=10)
ax.grid(alpha=0.2, zorder=0)

plt.tight_layout()
plt.savefig("core_sd_county_map.png", dpi=150, bbox_inches="tight")
plt.show()
print("Saved: core_sd_county_map.png")

# ── 11. Inset map — zoomed into study areas ───────────────────────────────────
fig2, ax2 = plt.subplots(figsize=(12, 10))
ax2.set_aspect("auto")

# Community planning districts (zoomed area)
if has_cpd:
    cpd.plot(ax=ax2, color="#f5f5f0", edgecolor="#cccccc",
             linewidth=0.5, alpha=0.9, zorder=1)

# Business points
if "industry_group" in core_gdf.columns:
    for group_name, color in colors.items():
        subset = core_gdf[core_gdf["industry_group"] == group_name]
        if len(subset):
            ax2.scatter(subset.geometry.x, subset.geometry.y,
                        c=color, s=12, alpha=0.8, zorder=3,
                        label=f"{group_name} (n={len(subset):,})")

# Study area buffers (zoomed)
for name, (x, y) in area_coords.items():
    center = gpd.GeoDataFrame(
        geometry=[Point(x, y)], crs="EPSG:4326"
    ).to_crs("EPSG:26911")
    buffer = center.geometry.buffer(1609).to_crs("EPSG:4326")
    bx, by = buffer.iloc[0].exterior.xy
    ax2.fill(bx, by, color="yellow", alpha=0.2, zorder=4)
    ax2.plot(bx, by, color="black", linewidth=2.0,
             linestyle="--", zorder=5)
    ax2.annotate(name, xy=(x, y), fontsize=10,
                 fontweight="bold", ha="center", color="black", zorder=6,
                 bbox=dict(boxstyle="round,pad=0.3", fc="white",
                           ec="black", alpha=0.85, linewidth=1.0))

# Zoom to study area extent with padding
xs = [c[0] for c in area_coords.values()]
ys = [c[1] for c in area_coords.values()]
ax2.set_xlim(min(xs) - 0.15, max(xs) + 0.15)
ax2.set_ylim(min(ys) - 0.10, max(ys) + 0.15)

ax2.set_title("Study Areas — Zoomed View\n"
              "Core Industrial & Logistics Businesses by NAICS Sector",
              fontsize=13, fontweight="bold")
ax2.legend(fontsize=9, loc="upper right",
           framealpha=0.9, edgecolor="gray")
ax2.set_xlabel("Longitude", fontsize=10)
ax2.set_ylabel("Latitude", fontsize=10)
ax2.grid(alpha=0.2, zorder=0)

plt.tight_layout()
plt.savefig("core_study_areas_zoom_map.png", dpi=150, bbox_inches="tight")
plt.show()
print("Saved: core_study_areas_zoom_map.png")

# ── 12. Business count summary per study area ─────────────────────────────────
print("\n" + "=" * 65)
print("BUSINESS COUNTS BY STUDY AREA (1-mile radius, core dataset)")
print("=" * 65)

gdf_proj = core_gdf.to_crs("EPSG:26911")
rows = []

for area_name, (x, y) in area_coords.items():
    center = gpd.GeoDataFrame(
        geometry=[Point(x, y)], crs="EPSG:4326"
    ).to_crs("EPSG:26911")
    buffer_geom = center.geometry.buffer(1609).iloc[0]
    subset = gdf_proj[gdf_proj.geometry.within(buffer_geom)]
    counts = (subset["industry_group"].value_counts()
              if "industry_group" in subset.columns else {})
    rows.append({
        "area":             area_name,
        "total_businesses": len(subset),
        "manufacturing":    counts.get("Manufacturing", 0),
        "wholesale":        counts.get("Wholesale Trade", 0),
        "transport_wh":     counts.get("Transportation and Warehousing", 0),
    })

summary = pd.DataFrame(rows)
summary["freight_pct"] = (
    summary["transport_wh"] /
    summary["total_businesses"].replace(0, 1) * 100
).round(1)

print(summary.to_string(index=False))
summary.to_csv("study_area_summary_core.csv", index=False)
print("\nSaved: study_area_summary_core.csv")
