import pandas as pd
from pathlib import Path
from arcgis.gis import GIS
from arcgis.geocoding import batch_geocode

# -----------------------------
# 1. Connect to ArcGIS Online
# -----------------------------
gis = GIS(username='gpec447sp26_23')  # works in ArcGIS Online notebooks / some DataHub setups

# -----------------------------
# 2. Load CSV files
# -----------------------------
files = [
    Path("tr_active1.csv"),
    Path("tr_active2.csv")
]

businesses = pd.concat(
    [
        pd.read_csv(
            f,
            dtype=str,
            engine="python",
            on_bad_lines="skip"
        )
        for f in files
    ],
    ignore_index=True
)

# -----------------------------
# 3. Clean column names
# -----------------------------
businesses.columns = (
    businesses.columns
    .str.strip()
    .str.lower()
    .str.replace(" ", "_")
    .str.replace("#", "num")
)

print("Columns:")
print(businesses.columns.tolist())

# -----------------------------
# 4. Clean NAICS field
# -----------------------------
businesses["naics"] = (
    businesses["naics"]
    .astype(str)
    .str.strip()
    .str.replace(".0", "", regex=False)
)

# -----------------------------
# 5. Initial broad NAICS filter
# -----------------------------
# 31-33 = Manufacturing
# 42 = Wholesale trade
# 48-49 = Transportation and warehousing

broad_prefixes = (
    "31", "32", "33",
    "42",
    "48", "49"
)

industrial_broad = businesses[
    businesses["naics"].str.startswith(broad_prefixes, na=False)
].copy()

print("Broad industrial/logistics businesses:", len(industrial_broad))

# -----------------------------
# 6. Classify broad industry groups
# -----------------------------
def classify_broad_industry(naics):
    naics = str(naics).strip()

    if naics.startswith(("31", "32", "33")):
        return "Manufacturing"
    elif naics.startswith("42"):
        return "Wholesale Trade"
    elif naics.startswith(("48", "49")):
        return "Transportation and Warehousing"
    else:
        return "Other"

industrial_broad["industry_group"] = industrial_broad["naics"].apply(classify_broad_industry)

print("\nBroad industry counts:")
print(industrial_broad["industry_group"].value_counts())

print("\nBroad NAICS 3-digit counts:")
print(industrial_broad["naics"].str[:3].value_counts().sort_index())

# -----------------------------
# 7. Validate / refine industrial definition
# -----------------------------
# Keep:
# 31-33 Manufacturing
# 421/422/423/424 Wholesale/distribution
# 481 Air transportation
# 483 Water transportation
# 484 Truck transportation
# 488 Support activities for transportation
# 491 Postal service
# 492 Couriers/messengers
# 493 Warehousing/storage
#
# Remove:
# 485 Passenger transportation
# 486 Pipeline transportation
# 487 Scenic/sightseeing transportation
# 425 Broker-only wholesale, if present

exclude_prefixes = (
    "425",
    "485",
    "486",
    "487"
)

keep_prefixes = (
    "31", "32", "33",
    "421", "422", "423", "424",
    "481", "483", "484", "488", "491", "492", "493"
)

industrial_broad["keep_for_analysis"] = (
    industrial_broad["naics"].str.startswith(keep_prefixes, na=False)
    & ~industrial_broad["naics"].str.startswith(exclude_prefixes, na=False)
)

industrial_clean = industrial_broad[
    industrial_broad["keep_for_analysis"]
].copy()

industrial_flagged = industrial_broad[
    ~industrial_broad["keep_for_analysis"]
].copy()

print("\nClean industrial/logistics businesses:", len(industrial_clean))
print("Flagged / excluded businesses:", len(industrial_flagged))

print("\nClean industry counts:")
print(industrial_clean["industry_group"].value_counts())

print("\nFlagged NAICS 3-digit counts:")
print(industrial_flagged["naics"].str[:3].value_counts().sort_index())

# -----------------------------
# 8. Export validation files before geocoding
# -----------------------------
industrial_broad.to_csv(
    "industrial_businesses_broad_naics.csv",
    index=False
)

industrial_clean.to_csv(
    "industrial_businesses_clean_naics.csv",
    index=False
)

industrial_flagged.to_csv(
    "industrial_businesses_flagged_for_review.csv",
    index=False
)

print("\nSaved validation CSVs:")
print("industrial_businesses_broad_naics.csv")
print("industrial_businesses_clean_naics.csv")
print("industrial_businesses_flagged_for_review.csv")

# -----------------------------
# 9. Create full address for clean dataset
# -----------------------------
industrial_clean["full_address"] = (
    industrial_clean["address"].fillna("") + ", " +
    industrial_clean["city"].fillna("") + ", " +
    industrial_clean["state"].fillna("") + " " +
    industrial_clean["zip"].fillna("")
)

industrial_clean = industrial_clean[
    industrial_clean["full_address"].str.len() > 10
].copy()

# -----------------------------
# 10. Geocode clean industrial/logistics businesses
# -----------------------------
# Use all clean records.
sample = industrial_clean.copy()

geocoded_results = batch_geocode(
    sample["full_address"].tolist(),
    as_featureset=True
)

geo_sdf = geocoded_results.sdf.reset_index(drop=True)
sample = sample.reset_index(drop=True)

print("\nGeocoding preview:")
print(geo_sdf[["Status", "Score", "Match_addr", "X", "Y"]].head())

# -----------------------------
# 11. Add geocoding results
# -----------------------------
business_points = sample.copy()

business_points["longitude"] = geo_sdf["X"]
business_points["latitude"] = geo_sdf["Y"]
business_points["geocode_score"] = geo_sdf["Score"]
business_points["matched_address"] = geo_sdf["Match_addr"]
business_points["geocode_status"] = geo_sdf["Status"]

business_points["longitude"] = pd.to_numeric(
    business_points["longitude"],
    errors="coerce"
)

business_points["latitude"] = pd.to_numeric(
    business_points["latitude"],
    errors="coerce"
)

business_points = business_points[
    (business_points["geocode_status"] == "M")
    & business_points["longitude"].notna()
    & business_points["latitude"].notna()
].copy()

print("\nSuccessfully geocoded clean businesses:", len(business_points))

# -----------------------------
# 12. Keep useful columns for ArcGIS Online
# -----------------------------
output_cols = [
    "business_acctnum",
    "dba_name",
    "ownership_type",
    "address",
    "city",
    "state",
    "zip",
    "naics",
    "activity_desc",
    "industry_group",
    "full_address",
    "matched_address",
    "geocode_score",
    "longitude",
    "latitude"
]

business_points = business_points[output_cols].copy()

# -----------------------------
# 13. Export final geocoded CSV
# -----------------------------
output_file = "industrial_businesses_validated_geocoded.csv"

business_points.to_csv(
    output_file,
    index=False
)

print(f"\nCSV exported successfully: {output_file}")

# -----------------------------
# 14. Final quality checks
# -----------------------------
print("\nFinal row count:", len(business_points))

print("\nFinal industry counts:")
print(business_points["industry_group"].value_counts())

print("\nFinal NAICS 3-digit counts:")
print(business_points["naics"].str[:3].value_counts().sort_index())

print("\nCoordinate preview:")
print(
    business_points[
        ["dba_name", "industry_group", "naics", "longitude", "latitude"]
    ].head()
)
