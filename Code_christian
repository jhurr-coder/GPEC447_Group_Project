import pandas as pd
from pathlib import Path
from arcgis.gis import GIS
from arcgis.geocoding import batch_geocode

# -----------------------------
# 1. Connect to ArcGIS Online
# -----------------------------
gis = GIS(username='gpec447sp26_23')  # works in ArcGIS Online notebooks / some DataHub setups

# -----------------------------
# 2. Load CSV files
# -----------------------------
files = [
    Path("tr_active1.csv"),
    Path("tr_active2.csv")
]

businesses = pd.concat(
    [
        pd.read_csv(
            f,
            dtype=str,
            engine="python",
            on_bad_lines="skip"
        )
        for f in files
    ],
    ignore_index=True
)

# -----------------------------
# 3. Clean column names
# -----------------------------
businesses.columns = (
    businesses.columns
    .str.strip()
    .str.lower()
    .str.replace(" ", "_")
    .str.replace("#", "num")
)

print("Columns:")
print(businesses.columns.tolist())

# -----------------------------
# 4. Filter by industrial/logistics NAICS
# -----------------------------
businesses["naics"] = businesses["naics"].astype(str).str.strip()

industrial_prefixes = (
    "31", "32", "33",   # Manufacturing
    "42",               # Wholesale trade
    "48", "49"          # Transportation and warehousing
)

industrial = businesses[
    businesses["naics"].str.startswith(industrial_prefixes, na=False)
].copy()

def classify_industry(naics):
    if naics.startswith(("31", "32", "33")):
        return "Manufacturing"
    elif naics.startswith("42"):
        return "Wholesale Trade"
    elif naics.startswith(("48", "49")):
        return "Transportation and Warehousing"
    else:
        return "Other"

industrial["industry_group"] = industrial["naics"].apply(classify_industry)

print("Industrial/logistics businesses:", len(industrial))
print(industrial["industry_group"].value_counts())

# -----------------------------
# 5. Create full address
# -----------------------------
industrial["full_address"] = (
    industrial["address"].fillna("") + ", " +
    industrial["city"].fillna("") + ", " +
    industrial["state"].fillna("") + " " +
    industrial["zip"].fillna("")
)

industrial = industrial[
    industrial["full_address"].str.len() > 10
].copy()

# -----------------------------
# 6. Geocode addresses
# -----------------------------
# Keep 100 while testing.
# After confirming the CSV works in ArcGIS Online,
# change to: sample = industrial.copy()
sample = industrial.copy()

geocoded_results = batch_geocode(
    sample["full_address"].tolist(),
    as_featureset=True
)

geo_sdf = geocoded_results.sdf.reset_index(drop=True)
sample = sample.reset_index(drop=True)

print("Geocoding preview:")
print(geo_sdf[["Status", "Score", "Match_addr", "X", "Y"]].head())

# -----------------------------
# 7. Add geocoding results to business records
# -----------------------------
business_points = sample.copy()

business_points["longitude"] = geo_sdf["X"]
business_points["latitude"] = geo_sdf["Y"]
business_points["geocode_score"] = geo_sdf["Score"]
business_points["matched_address"] = geo_sdf["Match_addr"]
business_points["geocode_status"] = geo_sdf["Status"]

business_points["longitude"] = pd.to_numeric(
    business_points["longitude"],
    errors="coerce"
)

business_points["latitude"] = pd.to_numeric(
    business_points["latitude"],
    errors="coerce"
)

# Keep only successfully matched records with valid coordinates
business_points = business_points[
    (business_points["geocode_status"] == "M")
    & business_points["longitude"].notna()
    & business_points["latitude"].notna()
].copy()

print("Successfully geocoded businesses:", len(business_points))

# -----------------------------
# 8. Keep useful columns for ArcGIS Online
# -----------------------------
output_cols = [
    "business_acctnum",
    "dba_name",
    "ownership_type",
    "address",
    "city",
    "state",
    "zip",
    "naics",
    "activity_desc",
    "industry_group",
    "full_address",
    "matched_address",
    "geocode_score",
    "longitude",
    "latitude"
]

business_points = business_points[output_cols].copy()

# -----------------------------
# 9. Export CSV for ArcGIS Online upload
# -----------------------------
output_file = "industrial_businesses_geocoded.csv"

business_points.to_csv(
    output_file,
    index=False
)

print(f"CSV exported successfully: {output_file}")

# -----------------------------
# 10. Quick quality checks
# -----------------------------
print("Final row count:", len(business_points))
print("Industry counts:")
print(business_points["industry_group"].value_counts())

print("Coordinate preview:")
print(business_points[["dba_name", "industry_group", "longitude", "latitude"]].head())
