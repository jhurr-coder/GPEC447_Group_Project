    roads_gdf = roads_gdf.set_crs("EPSG:4326")

roads_proj = roads_gdf.to_crs("EPSG:3310")

# ============================================================
# 8. Function: calculate distance to nearest freight road
# ============================================================
def distance_to_freight_roads(input_csv, output_csv):
    businesses = pd.read_csv(input_csv)

    business_gdf = gpd.GeoDataFrame(
        businesses,
        geometry=gpd.points_from_xy(
            businesses["longitude"],
            businesses["latitude"]
        ),
        crs="EPSG:4326"
    )

    business_proj = business_gdf.to_crs("EPSG:3310")

    nearest = gpd.sjoin_nearest(
        business_proj,
        roads_proj,
        how="left",
        distance_col="dist_to_freight_road_m"
    )

    nearest["dist_to_freight_road_mi"] = (
        nearest["dist_to_freight_road_m"] / 1609.34
    )

    nearest.to_csv(output_csv, index=False)

    print(f"\nExported: {output_csv}")
    print("Average distance to freight road, miles:")
    print(nearest["dist_to_freight_road_mi"].mean())

    print("\nMedian distance to freight road, miles:")
    print(nearest["dist_to_freight_road_mi"].median())

    print("\nBy industry group:")
    print(
        nearest.groupby("industry_group")["dist_to_freight_road_mi"]
        .agg(["count", "mean", "median", "min", "max"])
    )

    return nearest

