import pandas as pd
from pathlib import Path
from arcgis.gis import GIS
from arcgis.geocoding import batch_geocode

# -----------------------------
# 1. Connect to ArcGIS Online
# -----------------------------
gis = GIS(username='gpec447sp26_23')  # works in ArcGIS Online notebooks / some DataHub setups

# -----------------------------
# 2. Load CSV files
# -----------------------------
files = [
    Path("tr_active1.csv"),
    Path("tr_active2.csv")
]

businesses = pd.concat(
    [
        pd.read_csv(f, dtype=str, engine="python", on_bad_lines="skip")
        for f in files
    ],
    ignore_index=True
)

# -----------------------------
# 3. Clean columns
# -----------------------------
businesses.columns = (
    businesses.columns
    .str.strip()
    .str.lower()
    .str.replace(" ", "_")
    .str.replace("#", "num")
)

businesses["naics"] = (
    businesses["naics"]
    .astype(str)
    .str.strip()
    .str.replace(".0", "", regex=False)
)

# -----------------------------
# 4. Industry classifier
# -----------------------------
def classify_industry(naics):
    naics = str(naics).strip()

    if naics.startswith(("31", "32", "33")):
        return "Manufacturing"
    elif naics.startswith(("421", "422", "423", "424", "42")):
        return "Wholesale Trade"
    elif naics.startswith(("48", "49")):
        return "Transportation and Warehousing"
    elif naics.startswith("8113"):
        return "Industrial Machinery Repair"
    else:
        return "Other"

# -----------------------------
# 5. Define broad and core filters
# -----------------------------
# Broad = includes likely industrial ecosystem categories
broad_prefixes = (
    "31", "32", "33",      # Manufacturing
    "42",                  # Wholesale trade
    "48", "49",            # Transportation/warehousing
    "8113"                 # Industrial machinery/equipment repair
)

# Core = excludes passenger/scenic/pipeline and broker-only categories
core_keep_prefixes = (
    "31", "32", "33",      # Manufacturing
    "421", "422", "423", "424",  # Wholesale/distribution
    "481", "483", "484", "488", "491", "492", "493",  # Freight/logistics
    "8113"                 # Industrial machinery/equipment repair
)

core_exclude_prefixes = (
    "425",  # Wholesale brokers/electronic markets
    "485",  # Passenger transportation
    "486",  # Pipeline transportation
    "487"   # Scenic/sightseeing transportation
)

# -----------------------------
# 6. Create broad dataset
# -----------------------------
industrial_broad = businesses[
    businesses["naics"].str.startswith(broad_prefixes, na=False)
].copy()

industrial_broad["definition"] = "Broad"
industrial_broad["industry_group"] = industrial_broad["naics"].apply(classify_industry)

# -----------------------------
# 7. Create core dataset
# -----------------------------
industrial_core = industrial_broad[
    industrial_broad["naics"].str.startswith(core_keep_prefixes, na=False)
    & ~industrial_broad["naics"].str.startswith(core_exclude_prefixes, na=False)
].copy()

industrial_core["definition"] = "Core"
industrial_core["industry_group"] = industrial_core["naics"].apply(classify_industry)

# -----------------------------
# 8. Print validation summaries
# -----------------------------
print("Broad businesses:", len(industrial_broad))
print(industrial_broad["industry_group"].value_counts())

print("\nCore businesses:", len(industrial_core))
print(industrial_core["industry_group"].value_counts())

print("\nBroad NAICS 3-digit counts:")
print(industrial_broad["naics"].str[:3].value_counts().sort_index())

print("\nCore NAICS 3-digit counts:")
print(industrial_core["naics"].str[:3].value_counts().sort_index())

# -----------------------------
# 9. Geocoding function
# -----------------------------
def geocode_and_export(df, output_file):
    df = df.copy()

    df["full_address"] = (
        df["address"].fillna("") + ", " +
        df["city"].fillna("") + ", " +
        df["state"].fillna("") + " " +
        df["zip"].fillna("")
    )

    df = df[df["full_address"].str.len() > 10].copy()
    df = df.reset_index(drop=True)

    geocoded_results = batch_geocode(
        df["full_address"].tolist(),
        as_featureset=True
    )

    geo_sdf = geocoded_results.sdf.reset_index(drop=True)

    df["longitude"] = pd.to_numeric(geo_sdf["X"], errors="coerce")
    df["latitude"] = pd.to_numeric(geo_sdf["Y"], errors="coerce")
    df["geocode_score"] = geo_sdf["Score"]
    df["matched_address"] = geo_sdf["Match_addr"]
    df["geocode_status"] = geo_sdf["Status"]

    df = df[
        (df["geocode_status"] == "M")
        & df["longitude"].notna()
        & df["latitude"].notna()
    ].copy()

    output_cols = [
        "business_acctnum",
        "dba_name",
        "ownership_type",
        "address",
        "city",
        "state",
        "zip",
        "naics",
        "activity_desc",
        "industry_group",
        "definition",
        "full_address",
        "matched_address",
        "geocode_score",
        "longitude",
        "latitude"
    ]

    df = df[output_cols].copy()

    df.to_csv(output_file, index=False)

    print(f"\nExported: {output_file}")
    print("Final row count:", len(df))
    print(df["industry_group"].value_counts())

    return df

# -----------------------------
# 10. Geocode and export both datasets
# -----------------------------
core_points = geocode_and_export(
    industrial_core,
    "industrial_businesses_core_geocoded.csv"
)

broad_points = geocode_and_export(
    industrial_broad,
    "industrial_businesses_broad_geocoded.csv"
)
